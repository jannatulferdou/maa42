// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  uid   String @unique
  name  String
  email String @unique

  profileImage String?
  dateOfBirth  String?
  age          Int?
  gender       String?
  bloodGroup   String?

    // Pregnancy / Postpartum
  careStage            String? // "pregnant" | "postpartum"
  expectedDeliveryDate String?
  pregnancyWeek        Int?


  childbirthDate String?
  deliveryType   String?
  postpartumDay  Int?

  previousComplications    String?
  existingHealthConditions String?
  currentMedicines         String?

  doctor           String?
  clinic           String?
  emergencyContact String?

  role String @default("mother")

  shareWithDoctor    Boolean @default(true)
  emergencyAccess     Boolean @default(true)
  offlineSync        Boolean @default(true)
  chatHistoryEnabled Boolean @default(true)
  analyticsEnabled   Boolean @default(false)

  chatSummary String?

  notifications Notification[]
  healthCheckins HealthCheckin[]
  chatSessions  ChatSession[]
  emergencyContacts EmergencyContact[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}


model Notification {
  id     Int @id @default(autoincrement())
  userId Int

  title    String
  subtitle String
  type     String?
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthCheckin {
  id       Int @id @default(autoincrement())
  userId   Int

  symptoms String[]
  severity String
  notes    String?

  risk      String
  reason    String
  nextSteps String[]

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id Int @id @default(autoincrement())

  userId Int

  name String
  relation String
  phone String

  isFavorite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id            Int       @id @default(autoincrement())
  userId        Int
  title         String?
  endedAt       DateTime?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  messages ChatMessage[]
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId Int

  role    String
  content String

  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

